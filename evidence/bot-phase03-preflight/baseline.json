  "definitions": {
    "legacyReclaimed": "Unchanged tick-boundary non-neutral recapture metric; excludes zero-owner transitions and may omit transfers neutralized in the same tick.",
    "neutralizedRecovery": "Exact capture transfer of a previously stolen own cell from owner 0, within 60 seconds in the same victim life; death resets ledger, spawn grants excluded. Acquisition events, not unique lifetime cells.",
    "enemyRecovery": "Same exact-transfer ledger, previousOwner > 0; diagnostic only, not substituted for legacy audit reclaim.",
    "damageLedger": "Audit-only unbounded cell ledger for a 60-second window; distinct from HUD/AI bounded 96-cell damage memory.",
    "guardTicks": "Observer notifications with PERIMETER_GUARD, counted once per bot/tick.",
    "guardInterruptedPlans": "Active selected expansion interrupted by a perimeter override, counted once per plan. Ends on capture, death, replacement, attack/reposition, or non-early RETURN/ESCAPE. May still close and capture on the interrupted route.",
    "guardInterruptedDPlans": "Subset whose selected plan had predicted reclaimCells > 0; not necessarily bonus > 0."
